public static void main(String[] args) {
        StudentLinkedList list = new StudentLinkedList();

        // 1 & 2. Create singly linked list and insert five student numbers
        list.append(101);
        list.append(102);
        list.append(103);
        list.append(104);
        list.append(105);

        // 3. Display initial values
        System.out.print("Initial:\n");
        list.display();
        System.out.println();

        // 4. Add a new value at the beginning
        System.out.println("Insert 100:");
        list.insertAtBeginning(100);
        list.display();
        System.out.println();

        // 5. Search for a specified value
        int searchValue = 103;
        if (list.search(searchValue)) {
            System.out.println("Search " + searchValue + ": Found");
        } else {
            System.out.println("Search " + searchValue + ": Not Found");
        }
        System.out.println();

        // 6. Delete a specified value
        System.out.println("Delete 103:");
        list.delete(103);

        // 7. Display final linked list
        list.display();
    }
}
